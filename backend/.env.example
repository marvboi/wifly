# Wifly backend. Copy to .env (never commit it) and fill in.
# Port the API listens on.
PORT=
# libsql/SQLite URL. Local file by default (file:data/wifly.db). A Turso URL works too.
DATABASE_URL=
# Turso auth token, only when DATABASE_URL points at Turso.
DATABASE_AUTH_TOKEN=
# Secret used to sign session JWTs. Required in production (32+ random bytes).
SESSION_SECRET=
# production on Railway. The server never seeds demo data.
NODE_ENV=
# 1 = allow dev-only shortcuts with NODE_ENV=production (throwaway staging databases only). Leave unset on the live site.
ALLOW_DEMO_SEED=
# Comma separated full origins: CORS, the SIWE domain/URI check and the session cookie.
# Production: https://wifly.fun,https://app.wifly.fun,https://wifly-web-production.up.railway.app
ALLOWED_ORIGINS=
# Optional override for the hosts allowed in the sign-in message domain (defaults to the ALLOWED_ORIGINS hosts).
SIWE_DOMAINS=
# Legacy name for ALLOWED_ORIGINS (read only when ALLOWED_ORIGINS is unset).
CORS_ORIGINS=
# Optional parent domain for the session cookie (e.g. wifly.fun). Unset = host-only cookie.
COOKIE_DOMAIN=
# Set to 1 behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=
# Robinhood Chain JSON-RPC (read only: smart-account ERC-1271/6492 sign-in checks and handleNonce). Defaults to the public RPC.
RPC_URL=
# Comma-separated extra public RPCs (after RPC_URL). Empty = built-in official + dRPC + PublicNode.
RPC_URLS=
# Per-IP cap per minute on /api/price and /api/swap/quote (default 120).
PRICE_PER_IP_MIN=
# Privy app ID (public) from dashboard.privy.io. Empty = Privy sign-in off, wallet sign-in only.
# Identity tokens are verified with Privy's public JWKS. Turn on "return user data in an identity token" in the Privy dashboard.
# PRIVY_APP_SECRET (Railway only, set by the owner) is the fallback: access token + server-side user lookup when no identity token comes back.
# The secret stays on the server. Never put it in the frontend or a VITE_ variable.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the identity-token verification key (SPKI PEM) from the Privy dashboard. Empty = fetched from Privy's JWKS.
PRIVY_VERIFICATION_KEY=
# linkHandle attester: private key of the address set as attester on the Wifly contract, plus the contract address.
# Server only. Empty = /api/x/attest answers 503.
ATTESTER_PRIVATE_KEY=
WIFLY_CONTRACT_ADDRESS=
# Redis for the shared price cache, rate limits and SSE fan-out across replicas (Railway Redis: ${{Redis.REDIS_URL}}). Empty = in-memory, single instance only — this is the production path. REDIS_URL is not required; at boot the api logs `[cache] using memory` or `[cache] using redis`.
REDIS_URL=
# Price cache lifetime in ms (default 12000).
PRICE_TTL_MS=
# Chainlink ETH/USD proxy on Robinhood Chain. Empty = the verified default.
CHAINLINK_ETH_USD=
# Contract addresses, once deployed (empty = market/burn/Plus writes answer 503, the app reads sample data).
NAMES_CONTRACT_ADDRESS=
BADGES_CONTRACT_ADDRESS=
# WiflyNameRenderer address once deployed. Empty = the backend runs the same compiled renderer bytecode locally (design C).
NAMES_RENDERER_ADDRESS=
# Team wallet that runs the Wifly Plus creator account (tier 0).
PLUS_CREATOR_ADDRESS=
# Optional overrides; defaults mirror the contracts (1,500 / 15,000 WIF, 2.5% market fee, 100 / 1,000 WIF claim fee).
PLUS_PRICE_MONTH=
PLUS_PRICE_YEAR=
NAMES_FEE_BPS=
NAMES_CLAIM_FEE=
NAMES_SHORT_FEE=

# Companion agent (server-only). AGENT_PRIVATE_KEY is set only in the Railway dashboard; never commit or paste it.
# Users authorise this key's ADDRESS with Wifly.setAgent(agent, dailyCap). It can only call tipFor / subscribeFor /
# subscribeForPlan / takeTopSpotFor, spending from deposited balances, within each user's daily cap. It can't withdraw.
AGENT_PRIVATE_KEY=
# env (default) or kms (signer interface in src/agent/signer.ts; plug a vault/KMS signer in later)
AGENT_SIGNER=env
# Public agent address to show when the key isn't loaded here (optional)
AGENT_ADDRESS=
# Keep false until contracts are deployed and the launch is approved. Without it every agent action is a labelled preview.
AGENT_TX_ENABLED=false

# --- creator-of-the-week keeper (calls Wifly.finalizeEpoch after each week). Keep false until the launch is approved.
WEEK_KEEPER_ENABLED=false
WEEK_KEEPER_INTERVAL_MS=
# env (default) or kms
KEEPER_SIGNER=
# Set only in the Railway dashboard. Never commit or paste it. Empty = use the agent signer.
KEEPER_PRIVATE_KEY=

# --- DCA (WiflyDCA). Empty address = DCA preview: plans saved in the app, nothing sent, no fills.
DCA_CONTRACT_ADDRESS=
# Keep false until the launch is approved. The keeper calls executeBatch for due plans whose owner has Plus (incl. grace).
DCA_KEEPER_ENABLED=false
DCA_KEEPER_INTERVAL_MS=
DCA_KEEPER_MAX_SCAN=
# Set only in the Railway dashboard. Never commit or paste it. It only pays gas (~300k per buy); its address needs WiflyDCA.setKeeper(addr, true).
# Empty = the keeper uses KEEPER_PRIVATE_KEY. Not an allowed keeper or contract paused = it waits and sends nothing.
WIFLY_KEEPER_PRIVATE_KEY=

# --- AI companion. Both keys empty = chat is off; the command parser and quick answers still work.
# Z.ai GLM (glm-4.7-flash, free) answers first when set; a 429, timeout or error falls back to OpenRouter.
# Set only in the Railway dashboard (wifly-api). Never commit or paste them.
ZAI_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model list, tried in order. FREE models only: anything not a "<vendor>/<model>:free" id is ignored.
# Empty = google/gemma-4-31b-it:free, nvidia/nemotron-3.5-super-vl:free.
AI_MODELS=
# One model request / a whole answer (every tool round and fallback). Defaults 20000 / 45000.
AI_TIMEOUT_MS=
AI_ANSWER_BUDGET_MS=
AI_DAILY_LIMIT=
AI_PER_MINUTE=
# Free (non-Plus) users: model Q&A messages per day. No commands without Plus.
FREE_AI_MSGS_PER_DAY=3

# --- sign-up friction. Both Turnstile keys empty = no challenge.
TURNSTILE_SITE_KEY=
# Set only in the Railway dashboard. Never commit or paste it.
TURNSTILE_SECRET_KEY=
NEW_ACCOUNT_COOLDOWN_MIN=
SIGNUP_PER_IP_HOUR=
# 11.8.3: the human check never blocks sign-up. a missing/failed check (or a siteverify outage) falls back to these per-IP caps.
# defaults: 5 per 10 min, 20 per day, siteverify wait 3000 ms
SIGNUP_UNVERIFIED_PER_IP_10MIN=
SIGNUP_UNVERIFIED_PER_IP_DAY=
TURNSTILE_VERIFY_TIMEOUT_MS=
GUEST_READS_PER_MIN=

# --- owner tools. Comma-separated wallets that may open /settings/accounts and the "who owns this wallet" lookup.
# Empty = those pages and /api/admin/* answer 404 for everyone.
ADMIN_ADDRESSES=

# --- tip notifications. The verifier sweep also reads onchain Wifly Tipped events and records any tip the app missed
# (tips sent from outside wallets, or a client call that never landed), then notifies the recipient once per tx.
# First run looks back this many blocks, then keeps a cursor. Default 1000000.
TIPS_BACKFILL_BLOCKS=
