# Wifly backend. Copy to .env (never commit it) and fill in.
# Port the API listens on.
PORT=
# libsql/SQLite URL. Local file by default (file:data/wifly.db). A Turso URL works too.
DATABASE_URL=
# Turso auth token, only when DATABASE_URL points at Turso.
DATABASE_AUTH_TOKEN=
# Secret used to sign session JWTs. Required in production (32+ random bytes).
SESSION_SECRET=
# production on Railway. The server never seeds demo data.
NODE_ENV=
# 1 = allow dev-only shortcuts with NODE_ENV=production (throwaway staging databases only). Leave unset on the live site.
ALLOW_DEMO_SEED=
# 1 = once, at boot: the @ass account picks a new @name at next sign-in (backup first, nothing deleted). Leave unset otherwise.
RETIRE_ASS_HANDLE=
# Comma separated full origins: CORS, the SIWE domain/URI check and the session cookie.
# Production: https://wifly.fun,https://app.wifly.fun,https://wifly-web-production.up.railway.app
ALLOWED_ORIGINS=
# Optional override for the hosts allowed in the sign-in message domain (defaults to the ALLOWED_ORIGINS hosts).
SIWE_DOMAINS=
# Legacy name for ALLOWED_ORIGINS (read only when ALLOWED_ORIGINS is unset).
CORS_ORIGINS=
# Optional parent domain for the session cookie (e.g. wifly.fun). Unset = host-only cookie.
COOKIE_DOMAIN=
# Set to 1 behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=
# Robinhood Chain JSON-RPC (read only: smart-account ERC-1271/6492 sign-in checks and handleNonce). Defaults to the public RPC.
RPC_URL=
# Privy app ID (public) from dashboard.privy.io. Empty = Privy sign-in off, wallet sign-in only.
# Identity tokens are verified with Privy's public JWKS. Turn on "return user data in an identity token" in the Privy dashboard.
# PRIVY_APP_SECRET (server only) is the fallback: access token + server-side user lookup when no identity token comes back.
# The secret stays on the server. Never put it in the frontend or a VITE_ variable.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the identity-token verification key (SPKI PEM) from the Privy dashboard. Empty = fetched from Privy's JWKS.
PRIVY_VERIFICATION_KEY=
# linkHandle attester: private key of the address set as attester on the Wifly contract, plus the contract address.
# Server only. Empty = /api/x/attest answers 503.
ATTESTER_PRIVATE_KEY=
WIFLY_CONTRACT_ADDRESS=
# Redis for the shared price cache, rate limits and SSE fan-out across replicas (Railway Redis: ${{Redis.REDIS_URL}}). Empty = in-memory, single instance only.
REDIS_URL=
# Price cache lifetime in ms (default 12000).
PRICE_TTL_MS=
# Chainlink ETH/USD proxy on Robinhood Chain. Empty = the verified default.
CHAINLINK_ETH_USD=
# Contract proxy addresses (empty = market/burn/Plus writes answer 503, the app reads sample data).
NAMES_CONTRACT_ADDRESS=
BADGES_CONTRACT_ADDRESS=
# WiflyNameRenderer address once deployed. Empty = the backend runs the same compiled renderer bytecode locally (design C).
NAMES_RENDERER_ADDRESS=
# Team wallet that runs the Wifly Plus creator account (tier 0).
PLUS_CREATOR_ADDRESS=
# Optional overrides; defaults mirror the contracts (1,500 / 15,000 WIF, 2.5% market fee, 100 / 1,000 WIF claim fee).
PLUS_PRICE_MONTH=
PLUS_PRICE_YEAR=
NAMES_FEE_BPS=
NAMES_CLAIM_FEE=
NAMES_SHORT_FEE=

# Companion agent (server-only). Set AGENT_PRIVATE_KEY in the hosting env only; never commit it.
# Users authorise this key's ADDRESS with Wifly.setAgent(agent, dailyCap). It can only call tipFor / subscribeFor /
# subscribeForPlan / takeTopSpotFor, spending from deposited balances, within each user's daily cap. It can't withdraw.
AGENT_PRIVATE_KEY=
# env (default) or kms (signer interface in src/agent/signer.ts; plug a vault/KMS signer in later)
AGENT_SIGNER=env
# Public agent address to show when the key isn't loaded here (optional)
AGENT_ADDRESS=
# Keep false until the contracts are deployed and reviewed. Without it every agent action is a labelled preview.
AGENT_TX_ENABLED=false

# --- creator-of-the-week keeper (calls Wifly.finalizeEpoch after each week). Off by default.
WEEK_KEEPER_ENABLED=false
WEEK_KEEPER_INTERVAL_MS=
# env (default) or kms
KEEPER_SIGNER=
# Set in the hosting env only. Never commit it. Empty = use the agent signer.
KEEPER_PRIVATE_KEY=

# --- DCA (WiflyDCA). Empty address = DCA preview: plans saved in the app, nothing sent, no fills.
DCA_CONTRACT_ADDRESS=
# Off by default. The keeper calls executeBatch for due plans whose owner has Plus (incl. grace).
DCA_KEEPER_ENABLED=false
DCA_KEEPER_INTERVAL_MS=
DCA_KEEPER_MAX_SCAN=
# Set in the hosting env only. Never commit it. It only pays gas (~300k per buy); its address needs WiflyDCA.setKeeper(addr, true).
WIFLY_KEEPER_PRIVATE_KEY=

# --- AI companion (OpenRouter). Empty key = chat is off; the command parser and quick answers still work.
# Set in the hosting env only. Never commit it.
OPENROUTER_API_KEY=
# Comma-separated model list, tried in order. FREE models only: anything not ending in ":free" (or openrouter/free) is ignored.
# Empty = nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free, openrouter/free.
AI_MODELS=
AI_DAILY_LIMIT=
AI_PER_MINUTE=
# Free (non-Plus) users: model Q&A messages per day. No commands without Plus.
FREE_AI_MSGS_PER_DAY=3

# --- sign-up friction. Both Turnstile keys empty = no challenge.
TURNSTILE_SITE_KEY=
# Set in the hosting env only. Never commit it.
TURNSTILE_SECRET_KEY=
NEW_ACCOUNT_COOLDOWN_MIN=
SIGNUP_PER_IP_HOUR=
GUEST_READS_PER_MIN=
