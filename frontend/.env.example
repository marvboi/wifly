# Public build-time values only. Never put a secret in a VITE_ variable.
# Privy app ID (public). Empty = the wallet-only sign-in sheet.
VITE_PRIVY_APP_ID=
# Contract proxy addresses on Robinhood Chain (4663). Empty = sample data, no transactions.
VITE_WIFLY_ADDRESS=
VITE_NAMES_ADDRESS=
VITE_BADGES_ADDRESS=
# The Wifly agent's wallet (setAgent on the agent screen).
VITE_WIFLY_AGENT_ADDRESS=
# Team wallet that runs the Plus creator account (tier 0): Plus = subscribePlan(teamWallet, 0, plan).
VITE_WIFLY_TEAM_WALLET=
# Set to true to enable onchain writes. Anything else = every write button stays in preview mode.
VITE_TX_ENABLED=
# WalletConnect Cloud project id (public). Empty = WalletConnect is hidden; MetaMask, Rabby and other browser wallets still work.
VITE_WALLETCONNECT_PROJECT_ID=
# WiflyDCA proxy. Empty = the DCA screen saves preview plans and sends nothing.
VITE_DCA_ADDRESS=
# Comma-separated admin wallets allowed on the hidden /deploy page. Empty = the treasury 0x8E5f84738C0fb29670F370F73E53BD234CEfeF21 only.
VITE_ADMIN_ADDRESSES=
# true = keep /deploy available after the contract addresses are set (it is always available while they are empty).
VITE_DEPLOY_PAGE=

# Host split (build-time, public). Landing on VITE_SITE_URL, app on VITE_APP_URL. Both empty = single-host behaviour.
VITE_SITE_URL=https://wifly.fun
VITE_APP_URL=https://app.wifly.fun
# Runtime (Caddy): space-separated origins added to the CSP frame-ancestors/connect-src. Default covers wifly.fun, app.wifly.fun and the Railway URL.
SITE_ORIGINS=
