# Copy to .env and fill in. Never commit .env. No private keys here:
# import the deploy key into an encrypted keystore with `cast wallet import wifly-deployer --interactive`.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WIF is hard-coded (0x5173b8ea6923c2d40267890d45c46a3480954773); the script only runs on chain 4663.
# Every contract (except the swappable NameRenderer) is a UUPS proxy: the script deploys an implementation plus an
# ERC1967Proxy and calls initialize(). Use the PROXY addresses everywhere (frontend, backend, docs).
# Owner of every proxy = admin AND the only key that can upgrade the code (ideally a multisig or hardware wallet).
# Optional: defaults to WIFLY_TREASURY. Ownership is 2-step (transferOwnership + acceptOwnership).
WIFLY_OWNER=
# Address of the backend signer that attests X-account links (address only)
WIFLY_ATTESTER=
# Minimum Top Spot bid when the spot is empty, in wei (100 WIF)
WIFLY_TOP_SPOT_FLOOR=100000000000000000000
WIFLY_USE_BURN=true
# Gets 50% of every fee in Wifly and WiflyNames (split: 50% treasury, 40% community pot, 10% burn).
# Defaults to 0x8E5f84738C0fb29670F370F73E53BD234CEfeF21 if unset.
WIFLY_TREASURY=0x8E5f84738C0fb29670F370F73E53BD234CEfeF21
# WiflyNames claim fees in wei, split 50/40/10 like every fee (defaults: 100 WIF; 1,000 WIF for 3-4 char names)
NAMES_CLAIM_FEE=100000000000000000000
NAMES_SHORT_FEE=1000000000000000000000
# WiflyBadges metadata URI (ERC-1155 {id} template) and comma-separated thresholds in wei (default 1k,10k,100k,1M WIF)
BADGES_URI=https://wifly.fun/badges/{id}.json
BADGE_THRESHOLDS=1000000000000000000000,10000000000000000000000,100000000000000000000000,1000000000000000000000000
DEPLOY_NAMES=true
DEPLOY_BADGES=true
# WiflyDCA: ETH -> WIF dollar-cost averaging through the Uniswap v4 pool (no platform fee)
DEPLOY_DCA=true
# Bot address allowed to run DCA buys (address only, no key). Set at deploy if the broadcaster is the owner;
# otherwise the owner calls setKeeper(keeper, true) afterwards. Can be left empty.
WIFLY_KEEPER=

# Team-reserved usernames, minted free to NAMES_RESERVE_TO (defaults to owner) at deploy
NAMES_RESERVED=wifly,marv,wif
# NAMES_RESERVE_TO=0x...  (defaults to owner)
